" Vim config
"
" Layout:
"   config/               editor settings (options, keymaps, autocmds, filetypes, colorscheme)
"   lsp/                  LSP setup (options, servers, keymaps, autocmds)
"   plugins/              one file per plugin + the package manager
"   autoload/helpers.vim  shared helper functions

scriptencoding utf-8

let mapleader = ' '
let maplocalleader = ' '

let s:dir = expand('<sfile>:p:h')

" Editor: options, keymaps, autocommands, filetypes
execute 'source' fnameescape(s:dir . '/config/init.vim')

" Plugins: packages, install/update, per-plugin config
execute 'source' fnameescape(s:dir . '/plugins/init.vim')

" Colorscheme last, so plugin-provided schemes are available
execute 'source' fnameescape(s:dir . '/config/ui.vim')

" must be written at the last.  see :help 'secure'.
set secure
